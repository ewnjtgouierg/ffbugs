{
  "manifest_version": 2,
"browser_specific_settings": {
  "gecko": {
    "id": "test@addon",
    "strict_min_version": "1.1.0"
  }
},
  "name": "test",
  "description": "test",
  "version": "1.1",
  "content_security_policy": "script-src 'self' https://ajax.googleapis.com; object-src 'self'",
  "background": {
    "scripts": ["bg.js"],
    "persistent": true
  },
 "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "run_at": "document_start",
      "js": ["content.js"]
    }
		],
  "permissions": [
  	"nativeMessaging",
  	"tabs",
  	"idle",
    "activeTab",
	"storage",
	"proxy",
  	"webRequest",
  	"webRequestBlocking",
	"<all_urls>"
  ]
}